# ==============================================================================
# Storage Configuration (Turso Database OR Google Sheets)
# ==============================================================================
# The application automatically chooses the storage provider based on your environment variables in Vercel:
# 
# OPTION 1: TURSO DATABASE (libSQL Cloud)
# Set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# OPTION 2: GOOGLE SHEETS
# Set VITE_SHEET_ID (or GOOGLE_SHEET_ID) to your spreadsheet ID:
VITE_SHEET_ID=

# (Optional) Custom deployed Google Apps Script Web App URL if deploying your own Code.gs:
# GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/.../exec
